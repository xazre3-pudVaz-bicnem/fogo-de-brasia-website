# ─────────────────────────────────────────────
# 本番（Production）にのみ設定してください。
# Preview / Development には設定しないでください。
# 未設定の環境は自動的に noindex になり、sitemap と RSS が空になります。
# ─────────────────────────────────────────────

# サイトの基準URL。canonical・OG・構造化データ・sitemap の基点になります。
# 末尾スラッシュは付けないでください。
NEXT_PUBLIC_SITE_URL=https://example.jp

# 旧ドメイン（Vercel の仮ドメイン）。
# NEXT_PUBLIC_SITE_URL とあわせて設定すると、
# 旧ドメインへのアクセスを新ドメインへ 308 リダイレクトします。
LEGACY_HOST=fogo-de-brasia-website-maj4.vercel.app

# Search Console の HTML タグ認証を使う場合のみ設定（content の値だけ）。
# 未設定なら meta タグは出力されません。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
